# Dependencies
node_modules

# Build output
dist
dist-ssr
# Generated by the content build (Vite copies it into dist/data)
public/data/

# Claude
.claude/

# Firebase config and secrets
# The web API key is public by design (SPEC §2.2), but keep local config out of
# git so each environment sets its own. Commit .env.example instead.
.env
.env.*
!.env.example
*.local
# Admin credentials: never commit, never ship to the client
serviceAccount*.json
*-service-account*.json
*-firebase-adminsdk-*.json
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebase/

# Logs
logs
*.log
npm-debug.log*

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.sw?
