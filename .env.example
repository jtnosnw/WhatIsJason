# Copy to .env.local and fill in from Firebase console → Project settings → WhatIsJason web app.
# These values are public by design (SPEC §2.2). They stay out of git so each
# environment sets its own; CI reads them from GitHub Actions variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
